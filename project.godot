; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TalenTree"
run/main_scene="uid://bs5crmnj0l4vt"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

DataLoader="*uid://b52ivo8065pqp"
GameEvents="*uid://bb4wvf18uaht4"
GameManager="*uid://c0ad0taojbmne"
SoundPlayer="*uid://bgrg1cu2jme1"
MusicPlayer="*uid://eugyihqrau25"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=280
window/size/viewport_height=180
window/size/window_width_override=1400
window/size/window_height_override=900
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[file_customization]

folder_colors={
"res://Assets/": "yellow",
"res://Audio/": "orange",
"res://Fonts/": "gray",
"res://Resources/": "purple",
"res://Scenes/": "red",
"res://Scripts/": "green",
"res://Shaders/": "blue",
"res://Themes/": "pink"
}

[filesystem]

import/blender/enabled=false

